@page "/portfolio/add"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using BlazorJobSearch.Data
@using BlazorJobSearch.Data.Models
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components; @* Використовуєься для NavigationManager. *@
@using Microsoft.AspNetCore.Components.Web; @* Використовуєься для @onclick. *@
@using static Microsoft.AspNetCore.Components.Web.RenderMode; @* Використовуєься для @onclick. *@

@inject AuthenticationStateProvider authenticationStateProvider;
@inject IDbContextFactory<ApplicationDbContext> dbContextFactory;
@inject UserManager<ApplicationUser> userManager;
@inject NavigationManager navigationManager;
@* rendermode InteractiveServer Використовуєься для @onclick. *@
@rendermode InteractiveServer

@attribute [Authorize(Roles = "JobCandidate")]

<PageTitle>Портфоліо</PageTitle>

<h1>Додавання картинки</h1>

<EditForm Model="Input" enctype="multipart/form-data" OnSubmit="Submit" FormName="AddPicture">
	<DataAnnotationsValidator />
	<ValidationSummary class="text-danger" />
	<div class="form-group">
		<label for="name" class="form-label">
			Назва
		</label>
		<InputText @bind-Value="Input.Name" id="name" class="form-control" />
	</div>
	<div class="form-group">
		<label for="description" class="form-label">
			Опис
		</label>
		<InputTextArea @bind-Value="Input.Description" id="description" class="form-control" />
	</div>
	<div class="form-group">
		<label class="form-label">
			Картинка
		</label>
		<InputFile name="Input.File" OnChange="LoadFile" class="form-control" />
	</div>
	<div class="form-group">
		<br />
		<input type="submit" value="Додати" class="btn btn-primary" />
		<a href="@PortfolioUri" class="btn btn-secondary">Скасувати</a>
		<br />
	</div>
</EditForm>

<br />
<p>@Message</p>

@code {
	private Picture Picture { get; set; } = new Picture();

	[SupplyParameterFromForm(FormName = "AddPicture")]
	private InputModel Input { get; set; } = new();

	private string? Message { get; set; }

	private string? PortfolioUri { get; set; } = string.Empty;

	protected override void OnInitialized()
	{
		base.OnInitialized();
		PortfolioUri = navigationManager.BaseUri + "portfolio/portfolio";
	}

	private async Task LoadFile(InputFileChangeEventArgs e)
	{
		Message = "";
		long maxFileSize = 2097152;
		if (e != null && e.File != null)
		{
			if (e.File.Size > maxFileSize)
			{
				Message = "Файл перевищує 2МБ.";
			}
			if (e.File.ContentType.ToLower().StartsWith("image/") == false)
			{
				Message = "Файл не є картинкою.";
			}
			if (Message == "")
			{
				try
				{
					using (MemoryStream? memoryStream = new MemoryStream())
					{
						await e.File.OpenReadStream(maxFileSize).CopyToAsync(memoryStream);
						// Встановлення масива байтів.
						Picture.Data = memoryStream.ToArray();
						// Встановлення MimeType.
						Picture.MimeType = e.File.ContentType;
						// Встановлення імені файла.
						Picture.FileName = e.File.Name;
					}
				}
				catch (Exception ex)
				{
					Message = ex.Message;
				}
			}
		}
		else
		{
			Message = "Файл не вибрано.";
		}
	}

	private async Task Submit()
	{
		Message = "";
		if (Input.Name == null)
		{
			Message = "Потрібно ввести назву.";
		}
		if (Picture.MimeType != null && Picture.FileName != null && Picture.Data != null && Input.Name != null)
		{
			AuthenticationState? authState = await authenticationStateProvider
			.GetAuthenticationStateAsync();
			System.Security.Claims.ClaimsPrincipal? user = authState?.User;
			if (user?.Identity is not null && user.Identity.IsAuthenticated && user.IsInRole("JobCandidate"))
			{
				string? userId = userManager.GetUserId(user);
				using (ApplicationDbContext? dbContext = dbContextFactory.CreateDbContext())
				{
					JobCandidate? jobCandidate = await dbContext.JobCandidates
						.FirstOrDefaultAsync(j => j.ApplicationUserId == userId);
					if (jobCandidate != null)
					{
						Picture.JobCandidateId = jobCandidate.Id;
						Picture.Name = Input.Name;
						Picture.Description = Input.Description;
						try
						{
							dbContext.Portfolios.Add(Picture);
							await dbContext.SaveChangesAsync();
						}
						catch (Exception ex)
						{
							Message = ex.Message + " " + ex.InnerException;
						}
					}
				}
				if (Message == "")
				{
					Message = "Картинка вивантажена.";
					navigationManager.NavigateTo("/portfolio/portfolio");
				}
			}
		}
	}

	private sealed class InputModel
	{
		[Required, MaxLength(150), Display(Name = "Назва")]
		public string? Name { get; set; }

		[MaxLength(1000), Display(Name = "Опис")]
		public string? Description { get; set; }

		[Required(ErrorMessage = "Потрібно вибрати файл.")]
		public IFormFile? File { get; set; }
	}
}
