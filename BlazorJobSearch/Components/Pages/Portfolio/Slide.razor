@page "/portfolio/slide/{id:int}"
@using Microsoft.AspNetCore.Authorization
@using BlazorJobSearch.Data
@using BlazorJobSearch.Data.Models
@using Microsoft.EntityFrameworkCore
@using JobSearchServices
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Components @* Використовуєься для NavigationManager. *@

@inject IDbContextFactory<ApplicationDbContext> dbContextFactory;
@inject AppData appData
@inject ProtectedSessionStorage protectedSessionStore
@inject NavigationManager navigationManager;
@* rendermode InteractiveServer Використовуєься для @onclick, вимкнення попереднього відмальовування. *@
@rendermode InteractiveServer

@attribute [Authorize]

<AuthorizeView>
	@if (context.User.IsInRole("JobCandidate"))
	{
		<a href="portfolio/portfolio" class="btn btn-primary">Портфоліо</a>
		@if (Picture != null)
		{
			<span> &nbsp; </span>
			<a href=@("portfolio/delete/"+Picture.Id) class="btn btn-danger">Вилучити</a>
		}
	}
	@if (context.User.IsInRole("Employer"))
	{
		@* <a href=@(appData.Uri) class="btn btn-primary">Заявка на вакансію</a> *@
		<a href=@(Uri) id="jobrequest" class="btn btn-primary">Заявка на вакансію</a>
		@* <a id="jobrequest" class="btn btn-primary">Заявка на вакансію</a> *@
	}
</AuthorizeView>

@if (Picture != null)
{
	<PageTitle>@Picture.Name</PageTitle>

	<h1>@Picture.Name</h1>

	@if (Picture.Data != null)
	{
		<img src="data:image/jpeg;base64,@(Convert.ToBase64String(Picture.Data))" class="image" />
	}

	<p>@Picture.Description</p>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private string PortfolioUri { get; set; } = string.Empty;

	private Picture? Picture { get; set; }

	private string? Uri { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		using (ApplicationDbContext dbContext = await dbContextFactory.CreateDbContextAsync())
		{
			Picture = await dbContext.Portfolios.FindAsync(Id);
		}
	}

	protected override void OnInitialized()
	{
		base.OnInitialized();
		Uri = appData.Uri;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await base.OnAfterRenderAsync(firstRender);
		if (firstRender)
		{
			await GetDataAsync();
			StateHasChanged();
		}
	}

	private async Task GetDataAsync()
	{
		var result = await protectedSessionStore.GetAsync<string>("Uri");
		if (result.Success == true)
		{
			Uri = result.Value;
		}
	}
}
